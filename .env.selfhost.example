# Othor AI · self-host settings (docs/self-host.md). Copy to .env, fill in, keep it private.

# Which release, and which image: ghcr.io/othorai/othor (open) or ghcr.io/othorai/othor-ee
OTHOR_VERSION=0.21.0
OTHOR_IMAGE=ghcr.io/othorai/othor

# The address people open, e.g. othor.yourcompany.com (its DNS points at this server)
OTHOR_DOMAIN=
# Caddyfile (public, Let's Encrypt) or Caddyfile.internal (your network only)
CADDYFILE=Caddyfile

# Generate each with:  openssl rand -hex 32
OTHOR_SECRET_KEY=
POSTGRES_PASSWORD=

# The first person to sign up creates the company; after that, sign-up closes
OTHOR_SIGNUP=open

# Email (the Morning Brief, sign-in links): your SMTP server
#   smtp+starttls://user:password@smtp.yourcompany.com:587   (port 587, STARTTLS)
#   smtps://user:password@smtp.yourcompany.com:465          (port 465, TLS)
OTHOR_MAIL_RELAY=smtp
OTHOR_SMTP_URL=
# the domain emails come from (defaults to OTHOR_DOMAIN)
# OTHOR_MAIL_FROM_DOMAIN=

# Optional: a model for setup drafts and brief prose. Without one, briefs use templates and
# every number still works. template (no model) | anthropic (your own Anthropic API key;
# Anthropic then processes the brief's computed text for you, never rows from your databases)
OTHOR_MODEL_PROVIDER=template
# OTHOR_MODEL_ID=
# OTHOR_MODEL_API_KEY=

# Optional: Google Sheets as a source (your own Google Cloud OAuth client)
# OTHOR_SHEETS_MODE=google
# OTHOR_GOOGLE_CLIENT_ID=
# OTHOR_GOOGLE_CLIENT_SECRET=

# othor-ee only: your licence key (or paste it in Settings › Licence)
# OTHOR_LICENCE=

# Optional: your own legal page and support address, shown in the footer
# OTHOR_LEGAL_URL=
# OTHOR_SUPPORT_EMAIL=
