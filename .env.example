# Othor AI v0.1 — copy to .env
OTHOR_ENV=dev
OTHOR_BASE_DOMAIN=othor.localhost
OTHOR_DATA_DIR=./data
OTHOR_DB_URL=postgresql+psycopg://othor:othor@localhost:5442/othor
OTHOR_SECRET_KEY=change-me                # signs sessions and links
OTHOR_INSTANCE_KEY_FILE=./data/instance.key
OTHOR_MAIL_RELAY=smtp                      # console | smtp | postmark · dev: Mailpit from `make dev`
OTHOR_SMTP_URL=smtp://localhost:1026       # inbox at http://localhost:8026
OTHOR_MAIL_FROM_DOMAIN=othor.localhost
# cloud relay (OTHOR_MAIL_RELAY=postmark); the webhook is https://<base>/hooks/postmark/<secret>
OTHOR_POSTMARK_TOKEN=
OTHOR_POSTMARK_WEBHOOK_SECRET=
# links in emails: <scheme>://<slug>.<base>[:port]
OTHOR_PUBLIC_SCHEME=http
OTHOR_PUBLIC_PORT=8000
OTHOR_MODEL_PROVIDER=template              # template | anthropic | openai | local
OTHOR_MODEL_ID=
OTHOR_MODEL_API_KEY=
OTHOR_GOOGLE_CLIENT_ID=
OTHOR_GOOGLE_CLIENT_SECRET=
# Google Picker (drive.file scope only). fixture = local stand-in in data/sample/sheets
OTHOR_SHEETS_MODE=fixture
OTHOR_SIGNUP=open                         # invite (the cloud default) | open (dev, on-premise)
OTHOR_GOOGLE_API_KEY=
OTHOR_GOOGLE_APP_ID=
OTHOR_EGRESS_IPS=203.0.113.24,203.0.113.25
OTHOR_IPS_URL=https://othor.ai/ips
OTHOR_DEFAULT_SSL=require
OTHOR_MATERIALITY_FLOOR_INR=500000
# the most metrics in use per company (M15.1)
OTHOR_MAX_METRICS=60
OTHOR_FDR_Q=0.01

# Dev only: sample sources loaded by `make seed` (admin users; Othor AI itself reads as othor_ro)
OTHOR_SAMPLE_MYSQL_URL=mysql+pymysql://root:root_dev@localhost:3307/erp_db
OTHOR_SAMPLE_PG_URL=postgresql+psycopg://dw_admin:dw_admin_dev@localhost:5443/sales_dw
# the public landing page on the root host (othor.ai): 1 in the cloud and dev, 0 on-premise
OTHOR_PUBLIC_SITE=1
# client IP for rate limits: none (the socket) | fly (Fly-Client-IP, behind Fly's proxy only)
OTHOR_TRUST_PROXY=none
